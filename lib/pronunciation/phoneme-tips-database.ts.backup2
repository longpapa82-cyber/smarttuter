/**
 * 음소 발음 팁 검색
 */
export function getPhoneTip(phoneme: string): PhonemeTip | undefined {
  return consonantTips[phoneme] || vowelTips[phoneme];
}

/**
 * 단어에서 어려운 음소 찾기
 */
export function findDifficultPhonemes(word: string): PhonemeTip[] {
  const difficult: PhonemeTip[] = [];
  const lowerWord = word.toLowerCase();

  // 어려운 자음 패턴 감지
  const difficultPatterns = [
    { pattern: /th/g, phoneme: 'θ' },      // think
    { pattern: /the?[^n]/g, phoneme: 'ð' }, // the, father
    { pattern: /r/g, phoneme: 'r' },
    { pattern: /l/g, phoneme: 'l' },
    { pattern: /v/g, phoneme: 'v' },
    { pattern: /sh/g, phoneme: 'ʃ' },
    { pattern: /ng/g, phoneme: 'ŋ' },
  ];

  for (const { pattern, phoneme } of difficultPatterns) {
    if (pattern.test(lowerWord)) {
      const tip = getPhoneTip(phoneme);
      if (tip && tip.difficulty !== 'easy') {
        difficult.push(tip);
      }
    }
  }

  return difficult;
}

/**
 * 전체 음소 팁 목록
 */
export function getAllPhonemeTips(): PhonemeTip[] {
  return [
    ...Object.values(consonantTips),
    ...Object.values(vowelTips),
  ];
}

/**
 * 난이도별 필터링
 */
export function getPhonemeTipsByDifficulty(
  difficulty: 'easy' | 'medium' | 'hard'
): PhonemeTip[] {
  return getAllPhonemeTips().filter(tip => tip.difficulty === difficulty);
}
