// lib/pronunciation/phoneme-tips-database.ts
// 영어 발음 팁 종합 데이터베이스 (30+ 음소/패턴)

export interface PhonemeTip {
  phoneme: string;           // IPA 표기
  examples: string[];         // 예시 단어
  koreanGuide: string;        // 한국어 설명
  articulationTip: string;    // 조음 방법
  commonMistakes: string[];   // 흔한 실수
  practiceWords: string[];    // 연습 단어
  difficulty: 'easy' | 'medium' | 'hard';
  videoUrl?: string;          // 발음 영상 URL (향후 추가)
}

