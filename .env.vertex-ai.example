# ==========================================
# Vertex AI Configuration (무제한 서비스)
# ==========================================

# Google Cloud 프로젝트 ID
GCP_PROJECT_ID=smarttuter-production

# 지역 설정 (추천: us-central1 또는 asia-northeast3)
# us-central1: 가장 빠른 응답, 가장 저렴
# asia-northeast3: 서울 리전, 한국 사용자에게 유리
GCP_LOCATION=us-central1

# 서비스 계정 키 파일 경로
# 생성 방법: gcloud iam service-accounts keys create vertex-ai-key.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex-ai-key.json

# ==========================================
# Fallback: 기존 Gemini API (선택사항)
# ==========================================
# Vertex AI 설정이 안 되어 있을 경우 자동으로 사용
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Claude API (Multi-Model Verification용)
# ==========================================
# 선택사항: 답변 검증 강화를 위해 사용
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# 비용 관리
# ==========================================
# 일일 예산 (USD)
DAILY_BUDGET=100

# 월간 예산 (USD)
MONTHLY_BUDGET=3000

# 예산 초과 시 동작 (warn | throttle | stop)
# warn: 경고만 로그
# throttle: Flash 티어만 사용
# stop: 서비스 일시 중단
BUDGET_EXCEEDED_ACTION=throttle

# ==========================================
# 기능 토글
# ==========================================
# Vertex AI 사용 (true | false)
ENABLE_VERTEX_AI=false

# Multi-Model 검증 사용 (true | false)
# Claude API 키 필요
ENABLE_MULTI_MODEL_VERIFICATION=false

# 프롬프트 캐싱 사용 (90% 비용 절감)
ENABLE_PROMPT_CACHING=true

# ==========================================
# 기타 기존 설정들
# ==========================================
# ... 기존 환경 변수들 ...
