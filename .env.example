# ═══════════════════════════════════════════════════════
# AI Park - Environment Variables Configuration
# ═══════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────┐
# │ REQUIRED ENVIRONMENT VARIABLES (필수)                 │
# └─────────────────────────────────────────────────────┘

# Google Gemini API (필수 - AI 튜터 기능)
# Get your free API key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/minute, 1 million tokens/minute
GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth Configuration (필수 - 인증 시스템)
# Generate a random secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# NextAuth URL (필수 - 배포 환경에 맞게 변경)
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ┌─────────────────────────────────────────────────────┐
# │ OPTIONAL ENVIRONMENT VARIABLES (선택)                 │
# └─────────────────────────────────────────────────────┘

# Upstash Redis (권장 - 캐싱 성능 향상)
# Get free tier at: https://upstash.com
# Improves response time by caching AI responses
UPSTASH_REDIS_REST_URL=your_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Google OAuth (선택 - Google 계정 로그인)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Sentry Error Monitoring (선택 - 에러 모니터링)
# Get free tier at: https://sentry.io
SENTRY_DSN=your_sentry_dsn_here

# Google Cloud Text-to-Speech API (선택 - 고품질 음성 합성)
# Get your free API key at: https://console.cloud.google.com/apis/credentials
# Free tier: 4 million characters/month
# Note: Currently using browser Web Speech API by default
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Anthropic API (선택 - 대체 AI 모델)
# Note: Currently using Gemini API as primary AI model
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ┌─────────────────────────────────────────────────────┐
# │ CONFIGURATION NOTES                                  │
# └─────────────────────────────────────────────────────┘
#
# 1. Rename this file to .env.local for local development
# 2. Never commit .env.local to version control
# 3. For Vercel deployment, add variables in Project Settings
# 4. Required variables must be set for the app to function
# 5. Optional variables enhance functionality but aren't required
