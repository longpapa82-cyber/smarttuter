# ===================================
# LLM Provider API Keys
# ===================================
# Configure at least ONE provider for AI tutoring to work
# The system will automatically fallback in this priority order:
# 1. Claude (highest quality, $3/$15 per M tokens)
# 2. Gemini (fastest & cheapest, $0.15/$0.60 per M tokens)
# 3. OpenAI (balanced, $2.50/$10 per M tokens)

# Primary: Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Fallback 1: Google Gemini API Key (Recommended for cost savings!)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback 2: OpenAI API Key
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ===================================
# Next.js Configuration
# ===================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================
# Database (for future use)
# ===================================
# DATABASE_URL=your_database_url_here

# ===================================
# NextAuth (for future use)
# ===================================
# NEXTAUTH_SECRET=your_nextauth_secret_here
# NEXTAUTH_URL=http://localhost:3000
