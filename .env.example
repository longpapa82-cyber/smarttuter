# ═══════════════════════════════════════════════════════
# AI Park - Environment Variables Configuration
# ═══════════════════════════════════════════════════════
#
# 사용 방법:
# 1. 이 파일을 복사하여 .env.local 파일로 생성: cp .env.example .env.local
# 2. 아래 필수 변수들을 실제 값으로 변경
# 3. .env.local 파일은 절대 Git에 커밋하지 마세요 (이미 .gitignore에 포함됨)
# 4. Vercel 배포 시: Project Settings → Environment Variables에서 설정
#
# ═══════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────┐
# │ REQUIRED ENVIRONMENT VARIABLES (필수)                 │
# │ 이 변수들이 없으면 앱이 정상 작동하지 않습니다         │
# └─────────────────────────────────────────────────────┘

# Google Gemini API (필수 - AI 튜터 핵심 기능)
# 발급 방법: https://aistudio.google.com/apikey
# Free tier: 15 requests/minute, 1M tokens/minute, 1500 requests/day
# 사용처: 수학/영어/과학/사회 튜터 AI 응답 생성
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth Configuration (필수 - 사용자 인증 시스템)
# 생성 명령어: openssl rand -base64 32
# 용도: 세션 암호화, JWT 토큰 서명
NEXTAUTH_SECRET=your_nextauth_secret_here

# NextAuth URL (필수 - 인증 콜백 URL)
# Development: http://localhost:3000
# Production: https://aipark.vercel.app (또는 본인의 도메인)
NEXTAUTH_URL=http://localhost:3000

# Upstash Redis (필수 - 데이터 저장소)
# 발급 방법: https://upstash.com → Create Database (무료)
# Free tier: 10,000 commands/day, 256MB storage
# 사용처: 학습 세션 저장, 리포트 데이터, 사용자 프로필
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# ┌─────────────────────────────────────────────────────┐
# │ OPTIONAL ENVIRONMENT VARIABLES (선택)                 │
# │ 기능 향상을 위해 권장되지만 필수는 아닙니다            │
# └─────────────────────────────────────────────────────┘

# ──────────────────────────────────────────────────────
# OAuth 소셜 로그인 (선택)
# ──────────────────────────────────────────────────────

# Google OAuth (Google 계정으로 로그인)
# 발급 방법: https://console.cloud.google.com/apis/credentials
# 1. "Create Credentials" → "OAuth 2.0 Client ID"
# 2. Authorized redirect URIs 추가:
#    - http://localhost:3000/api/auth/callback/google (개발)
#    - https://aipark.vercel.app/api/auth/callback/google (프로덕션)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Kakao OAuth (카카오 계정으로 로그인)
# 발급 방법: https://developers.kakao.com/console/app
# 1. 애플리케이션 추가하기
# 2. 플랫폼 설정 → Web 플랫폼 추가
# 3. Redirect URI: http://localhost:3000/api/auth/callback/kakao
KAKAO_CLIENT_ID=your_kakao_client_id_here
KAKAO_CLIENT_SECRET=your_kakao_client_secret_here

# GitHub OAuth (GitHub 계정으로 로그인)
# 발급 방법: https://github.com/settings/developers
# 1. "New OAuth App" 클릭
# 2. Application name: AI Park (or your app name)
# 3. Homepage URL: http://localhost:3000 (개발) or https://aipark.vercel.app (프로덕션)
# 4. Authorization callback URL:
#    - http://localhost:3000/api/auth/callback/github (개발)
#    - https://aipark.vercel.app/api/auth/callback/github (프로덕션)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ──────────────────────────────────────────────────────
# 수학 OCR (필기 인식) - 권장
# ──────────────────────────────────────────────────────

# Mathpix OCR API (수식 필기 인식 99% 정확도)
# 발급 방법: https://mathpix.com/ocr
# Free tier: 1,000 requests/month
# Premium: $0.004/request (매우 저렴)
# 사용처: 수학 문제 사진 업로드 시 텍스트 변환
NEXT_PUBLIC_MATHPIX_APP_ID=your_mathpix_app_id_here
NEXT_PUBLIC_MATHPIX_APP_KEY=your_mathpix_app_key_here

# Google Vision API (OCR 대체 옵션)
# 발급 방법: https://console.cloud.google.com/apis/credentials
# 1. "Cloud Vision API" 활성화
# 2. API 키 생성
# Free tier: 1,000 units/month
# 사용처: Mathpix 없을 시 수학 필기 인식 백업
NEXT_PUBLIC_GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# ──────────────────────────────────────────────────────
# 대체 AI 모델 (선택)
# ──────────────────────────────────────────────────────

# Anthropic Claude API (고급 AI 대화 모델)
# 발급 방법: https://console.anthropic.com
# 참고: 현재 Gemini를 주요 모델로 사용 중
# 용도: Gemini API 장애 시 백업 또는 고급 기능
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NEXT_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (ChatGPT 모델)
# 발급 방법: https://platform.openai.com/api-keys
# 참고: 현재 사용하지 않음 (향후 확장 가능)
OPENAI_API_KEY=your_openai_api_key_here

# ──────────────────────────────────────────────────────
# Google Vertex AI (고급 설정)
# ──────────────────────────────────────────────────────

# Google Cloud 프로젝트에서 Vertex AI 사용 시 필요
# 발급 방법: https://console.cloud.google.com/vertex-ai
# 1. 프로젝트 생성
# 2. Vertex AI API 활성화
# 3. 서비스 계정 생성 및 JSON 키 다운로드
ENABLE_VERTEX_AI=false
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=asia-northeast3
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ──────────────────────────────────────────────────────
# 에러 모니터링 & 로깅 (권장)
# ──────────────────────────────────────────────────────

# Sentry (에러 추적 및 성능 모니터링)
# 발급 방법: https://sentry.io → Create Project → Next.js
# Free tier: 5,000 errors/month, 10,000 transactions/month
# 사용처: 프로덕션 에러 자동 수집, 성능 모니터링, 사용자 피드백
# 참고: 클라이언트와 서버에서 모두 사용 (NEXT_PUBLIC_ 필요)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Sentry 추가 설정 (선택)
# 배포 환경 추적 (development/staging/production)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# 에러 샘플링 비율 (1.0 = 100%, 0.1 = 10%)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# 세션 리플레이 샘플링 (에러 발생 시 사용자 행동 재현)
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ──────────────────────────────────────────────────────
# 기타 설정
# ──────────────────────────────────────────────────────

# Google Cloud Text-to-Speech API (고품질 음성 합성)
# 발급 방법: https://console.cloud.google.com/apis/credentials
# Free tier: 4 million characters/month
# 참고: 현재 브라우저 Web Speech API 사용 중
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# 앱 공개 URL (프론트엔드에서 사용)
# Development: http://localhost:3000
# Production: https://aipark.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────
# 비용 관리 (Cost Management)
# ──────────────────────────────────────────────────────

# AI API 비용 제어를 위한 예산 한도 설정
# BUDGET_EXCEEDED_ACTION: 예산 초과 시 동작
#   - "warn": 경고만 로그에 출력 (서비스 계속 작동)
#   - "block": API 호출 차단 (비용 초과 방지)
# DAILY_BUDGET: 일일 예산 한도 (USD)
# MONTHLY_BUDGET: 월간 예산 한도 (USD)
BUDGET_EXCEEDED_ACTION=warn
DAILY_BUDGET=10
MONTHLY_BUDGET=300

# ──────────────────────────────────────────────────────
# 성능 최적화 (Performance Optimization)
# ──────────────────────────────────────────────────────

# 프롬프트 캐싱 활성화 (AI 응답 속도 개선)
# true로 설정 시 동일한 프롬프트 재사용 시 캐시에서 빠르게 응답
ENABLE_PROMPT_CACHING=true

# 멀티 모델 검증 (AI 응답 품질 향상)
# true로 설정 시 여러 AI 모델로 답변 검증 (비용 증가)
# 일반적으로 false 권장, 중요한 답변만 true 설정
ENABLE_MULTI_MODEL_VERIFICATION=false

# ┌─────────────────────────────────────────────────────┐
# │ SYSTEM VARIABLES (자동 설정)                          │
# │ 수동으로 설정하지 마세요                              │
# └─────────────────────────────────────────────────────┘

# NODE_ENV - 자동으로 설정됨 (development/production)
# VERCEL_ENV - Vercel 배포 시 자동 설정
# VERCEL_GIT_COMMIT_SHA - Git 커밋 해시 (자동)

# ┌─────────────────────────────────────────────────────┐
# │ TROUBLESHOOTING (문제 해결)                           │
# └─────────────────────────────────────────────────────┘
#
# Q1: "GEMINI_API_KEY is not defined" 에러가 발생합니다.
# A1: .env.local 파일을 생성하고 GEMINI_API_KEY를 설정하세요.
#     Vercel 배포 시에는 Project Settings → Environment Variables에서 설정.
#
# Q2: Redis 연결 오류가 발생합니다.
# A2: UPSTASH_REDIS_REST_URL과 TOKEN이 올바른지 확인하세요.
#     Upstash 대시보드에서 REST API URL/Token을 복사하세요.
#
# Q3: 수학 필기 인식이 작동하지 않습니다.
# A3: NEXT_PUBLIC_MATHPIX_APP_ID/KEY 또는
#     NEXT_PUBLIC_GOOGLE_VISION_API_KEY를 설정하세요.
#
# Q4: Vercel 배포 후 환경 변수가 적용되지 않습니다.
# A4: Vercel 대시보드 → Settings → Environment Variables에서
#     Production/Preview/Development 환경별로 설정하고 재배포하세요.
#
# Q5: NextAuth 로그인이 작동하지 않습니다.
# A5: NEXTAUTH_URL이 현재 도메인과 일치하는지 확인하세요.
#     로컬: http://localhost:3000
#     프로덕션: https://aipark.vercel.app

# ┌─────────────────────────────────────────────────────┐
# │ QUICK START GUIDE (빠른 시작)                         │
# └─────────────────────────────────────────────────────┘
#
# 1. .env.local 파일 생성:
#    cp .env.example .env.local
#
# 2. 필수 변수 설정 (최소 3개):
#    - GEMINI_API_KEY (https://aistudio.google.com/apikey)
#    - NEXTAUTH_SECRET (openssl rand -base64 32)
#    - UPSTASH_REDIS_REST_URL & TOKEN (https://upstash.com)
#
# 3. 개발 서버 실행:
#    npm run dev
#
# 4. Vercel 배포:
#    vercel --prod
#    (환경 변수를 Vercel 대시보드에서 설정해야 함)
#
# 상세 가이드: /claudedocs/ENV_SETUP_GUIDE.md 참고
